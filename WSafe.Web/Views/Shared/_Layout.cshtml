@* Views/Shared/_Layout.cshtml *@
@using System.Configuration
@{
    var userRole = (Session["UserRole"] ?? "").ToString().Trim().ToUpperInvariant();
    var userName = (Session["userName"] ?? "").ToString().Trim();
    var openAIApiBase = ConfigurationManager.AppSettings["AnalysisApiBaseUrl"] ?? "http://127.0.0.1:5090";
    var analysisApiBase = ConfigurationManager.AppSettings["AnalysisApiBaseUrl"] ?? "http://127.0.0.1:5091";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - WSafe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- SOLO CDN para evitar conflictos con bundles -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    @Scripts.Render("~/bundles/modernizr")

    <style>
        .navbar {
            background: #1f2937;
        }

            .navbar .nav-link, .navbar .navbar-brand {
                color: #e5e7eb !important;
            }

                .navbar .nav-link:hover {
                    color: #fff !important;
                    text-decoration: underline;
                }

        .body-content {
            padding-top: 72px;
        }

        /* No usamos collapse para que NADA se esconda */
        .navbar-always {
            display: flex !important;
        }

        .navbar-nav .nav-item {
            white-space: nowrap;
        }

        .menu-scroll {
            overflow-x: auto;
            flex-wrap: nowrap;
        }

        .body-content {
            padding-top: 80px;
        }

        /* panel central completo con navbar fixed */
        .navbar .nav-link {
            color: #e5e7eb !important;
        }

        .navbar .nav-link:hover {
            color: #fff !important;
            text-decoration: underline;
        }

    </style>
</head>
<body>
    <!-- NAVBAR (forzado a visible, sin collapse ni dropdowns) -->
    <nav class="navbar navbar-dark fixed-top" style="background:#1f2937;">
        <div class="container-fluid d-flex align-items-center">
            <!-- Marca -->
            <a class="navbar-brand d-flex align-items-center mr-3" href="@Url.Action("Index","Home")">
                <img src="@Url.Content("~/Images/wsafe.jpg")" width="40" height="40" class="mr-2" alt="WSafe" />
                <strong>WSafe</strong>
            </a>

            <!-- Menú principal SIEMPRE visible, con scroll horizontal si no cabe -->
            <ul class="navbar-nav flex-row flex-nowrap overflow-auto" style="gap:10px;">
                @* === Items por rol: SIN colapsar, SIN bloques @{ HTML } *@
                @if (userRole == "ADMIN")
                {
                    <li class="nav-item">@Html.ActionLink("ENTIDAD", "Index", "Organizations", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("SG-SST", "Index", "Movimientos", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("EVALUACIONES", "Index", "Evaluations", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("RIESGOS", "Index", "Riesgos", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("INCIDENTES", "Index", "Incidentes", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("ACCIONES", "Index", "Acciones", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("INDICADORES", "Index", "Indicadores", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("USUARIOS", "Index", "Accounts", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("TRABAJADORES", "Index", "Workers", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("ACTOS INSEGUROS", "Index", "Unsafeacts", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("RECOMENDACIONES", "Index", "Recomendations", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("PLAN ANUAL", "Index", "AnnualPlans", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("OCUPACIONALES", "Index", "Occupationals", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("CAPACITACIONES", "Index", "Capacitations", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("VULNERABILIDADES", "Index", "Vulnerabilities", null, new { @class = "nav-link px-2" })</li>
                }
                else if (userRole == "LIDER RESPONSABLE SST")
                {
                    <li class="nav-item">@Html.ActionLink("RIESGOS", "Index", "Riesgos", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("INCIDENTES", "Index", "Incidentes", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("ACCIONES", "Index", "Acciones", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("ACTOS INSEGUROS", "Index", "Unsafeacts", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("RECOMENDACIONES", "Index", "Recomendations", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("PLAN ANUAL", "Index", "AnnualPlans", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("CAPACITACIONES", "Index", "Capacitations", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("VULNERABILIDADES", "Index", "Vulnerabilities", null, new { @class = "nav-link px-2" })</li>
                }
                else if (userRole == "ARL")
                {
                    <li class="nav-item">@Html.ActionLink("ENTIDAD", "Index", "Organizations", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("SG-SST", "Index", "Movimientos", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("EVALUACIONES", "Index", "Evaluations", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("PLAN ANUAL", "Index", "AnnualPlans", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("VULNERABILIDADES", "Index", "Vulnerabilities", null, new { @class = "nav-link px-2" })</li>
                }
                else if (userRole == "TRABAJADOR")
                {
                    <li class="nav-item">@Html.ActionLink("TRABAJADORES", "GetWorker", "Workers", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("RIESGOS", "Create", "Riesgos", null, new { @class = "nav-link px-2" })</li>
                    <li class="nav-item">@Html.ActionLink("ACTOS INSEGUROS", "Create", "Unsafeacts", null, new { @class = "nav-link px-2" })</li>
                }
                else
                {
                    <li class="nav-item">@Html.ActionLink("ACTOS INSEGUROS", "Create", "Unsafeacts", null, new { @class = "nav-link px-2" })</li>
                }

                @* === Menú IA en línea (no dropdown) === *@
                <li class="nav-item"><a class="nav-link px-2 font-weight-bold" href="#" data-toggle="modal" data-target="#mdlSupport">Support</a></li>
                <li class="nav-item"><a class="nav-link px-2 font-weight-bold" href="#" data-toggle="modal" data-target="#mdlPredict">Predict</a></li>
                <li class="nav-item"><a class="nav-link px-2 font-weight-bold" href="#" data-toggle="modal" data-target="#mdlAudit">Audit</a></li>
                <li class="nav-item"><a class="nav-link px-2 font-weight-bold" href="#" data-toggle="modal" data-target="#mdlDetect">Detect</a></li>
            </ul>

            <!-- Usuario (a la derecha) -->
            <span class="navbar-text text-light ml-auto">
                @if (!string.IsNullOrEmpty(userName))
                {<text>Hola, <strong>@userName</strong></text>}
            </span>
        </div>
    </nav>

    <div class="container-fluid body-content">
        @RenderBody()
        <hr />
        <footer class="text-muted"><p class="mb-1">&copy; @DateTime.Now.Year - WSafeApp</p></footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/bootstrap")

    <!-- JS CDN (sin bundles para evitar choques) -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)


    <!-- Modales IA -->
    <!-- Support -->
    <div class="modal fade" id="mdlSupport" tabindex="-1" role="dialog" aria-labelledby="supportTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="supportTitle" class="modal-title">Support (Asistente IA)</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group"><label>Pregunta</label><input id="supportPrompt" class="form-control" placeholder="Escribe tu pregunta..." /></div>
                    <pre id="outSupport" class="pretty" style="display:none"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnSupport" class="btn btn-success">Enviar</button>
                    <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Predict -->
    <div class="modal fade" id="mdlPredict" tabindex="-1" role="dialog" aria-labelledby="predictTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="predictTitle" class="modal-title">Predict</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group"><label>Activity</label><input id="predActivity" class="form-control" value="Trabajo en altura" /></div>
                    <div class="form-group"><label>Location</label><input id="predLocation" class="form-control" value="Planta Cali" /></div>
                    <div class="form-group"><label>HistoricalWindowMonths</label><input id="predWindow" type="number" class="form-control" value="12" /></div>
                    <div class="form-group"><label>TopNRecommendations (opcional)</label><input id="predTopN" type="number" class="form-control" value="3" /></div>
                    <pre id="outPredict" class="pretty" style="display:none"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnPredict" class="btn btn-primary">Enviar</button>
                    <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit -->
    <div class="modal fade" id="mdlAudit" tabindex="-1" role="dialog" aria-labelledby="auditTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="auditTitle" class="modal-title">Audit</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group"><label>Standard</label><input id="auditStd" class="form-control" value="ISO 45001" /></div>
                    <div class="form-group"><label>Content</label><textarea id="auditContent" rows="6" class="form-control">Política de SST 2025...</textarea></div>
                    <pre id="outAudit" class="pretty" style="display:none"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnAudit" class="btn btn-primary">Enviar</button>
                    <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Detect -->
    <div class="modal fade" id="mdlDetect" tabindex="-1" role="dialog" aria-labelledby="detectTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="detectTitle" class="modal-title">Detect</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Reports (uno por línea)</label>
                        <textarea id="detectReports" rows="6" class="form-control">
                            Operario sin arnés zona 3
                            Uso de celular en montacargas
                            Operario subiendo sin barandas
                        </textarea>
                    </div>
                    <pre id="outDetect" class="pretty" style="display:none"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnDetect" class="btn btn-primary">Enviar</button>
                    <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Base de la API (desde web.config o fallback)
        var openAIAapiBaseUrl = "@openAIApiBase".replace(/\/+$/, "");
        var analysisApiBaseUrl = "@analysisApiBase".replace(/\/+$/, "");

        function pretty(o){ try { return JSON.stringify(o,null,2); } catch(e){ return o; } }
        function setBusy($btn, busy, txt){
            var normal = $btn.data("normal") || $btn.text();
            if(!$btn.data("normal")) $btn.data("normal", normal);
            $btn.prop("disabled", busy).text(busy ? (txt||"Procesando...") : normal);
        }
        function show($pre, data){ $pre.text(pretty(data)).show(); }

        // === Llamadas a la API externa (ajusta si usas tus controladores MVC) ===
        $("#btnSupport").on("click", function(){
            var $btn = $(this); setBusy($btn,true);
            var prompt = $("#supportPrompt").val().trim();
            if(!prompt){ setBusy($btn,false); return; }

            fetch(openAIAapiBaseUrl + "/api/chatbot/support", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ prompt: prompt })
            })
            .then(r => r.json())
            .then(d => show($("#outSupport"), d))
            .catch(err => show($("#outSupport"), err && (err.responseText||err.message) || "Error"))
            .finally(()=> setBusy($btn,false));
        });

        $("#btnPredict").on("click", function(){
            var $btn = $(this); setBusy($btn,true);
            fetch(analysisApiBaseUrl + "/api/analysis/predict", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    activity: $("#predActivity").val(),
                    location: $("#predLocation").val(),
                    historicalWindowMonths: parseInt($("#predWindow").val()||"12"),
                    topNRecommendations: parseInt($("#predTopN").val()||"0") || null
                })
            })
            .then(r => r.json())
            .then(d => show($("#outPredict"), d))
            .catch(err => show($("#outPredict"), err && (err.responseText||err.message) || "Error"))
            .finally(()=> setBusy($btn,false));
        });

        $("#btnAudit").on("click", function(){
            var $btn = $(this); setBusy($btn,true);
            fetch(analysisApiBaseUrl + "/api/analysis/audit", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    standard: $("#auditStd").val(),
                    content: $("#auditContent").val()
                })
            })
            .then(r => r.json())
            .then(d => show($("#outAudit"), d))
            .catch(err => show($("#outAudit"), err && (err.responseText||err.message) || "Error"))
            .finally(()=> setBusy($btn,false));
        });

        $("#btnDetect").on("click", function(){
            var $btn = $(this); setBusy($btn,true);
            var reports = $("#detectReports").val().split(/\r?\n/).map(x=>x.trim()).filter(Boolean);
            fetch(analysisApiBaseUrl + "/api/analysis/detect", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ reports: reports })
            })
            .then(r => r.json())
            .then(d => show($("#outDetect"), d))
            .catch(err => show($("#outDetect"), err && (err.responseText||err.message) || "Error"))
            .finally(()=> setBusy($btn,false));
        });

    </script>

</body>
</html>
