@{
    Layout = null;
    var appName = "WSafe";
    var userRole = (Session["UserRole"] as string ?? "").Trim();
    var userName = (Session["userName"] as string ?? "").Trim();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - @appName</title>

    <!-- ===== Styles ===== -->
    <!-- Bootstrap 4 + FontAwesome (evitar duplicados) -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <!-- Plugins opcionales -->
    <link href="~/Content/bootstrap-table.min.css" rel="stylesheet" />

    @Styles.Render("~/Content/css")
    @RenderSection("styles", required: false)

    <style>
        body {
            padding-top: 70px;
        }

        .navbar {
            background-color: #C0C0C0;
        }
        /* silver */
        .navbar-brand-logo {
            height: 50px;
            margin-right: 10px;
        }

        .navbar .nav-link {
            color: #004aad !important;
            font-size: .95rem;
        }

            .navbar .nav-link:hover {
                color: #002b66 !important;
            }

        .toast-wsafe {
            position: fixed;
            right: 16px;
            bottom: 16px;
            z-index: 10500;
            background: #1f2937;
            color: #fff;
            padding: 10px 14px;
            border-radius: 6px;
            box-shadow: 0 6px 18px rgba(0,0,0,.25);
            display: none;
        }

        pre.result {
            background: #0b1020;
            color: #b9e3ff;
            border-radius: 6px;
            padding: 12px;
            overflow: auto;
            max-height: 300px;
        }
    </style>
</head>

<body>
    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index","Home")">
                <img src="@Url.Content("~/Images/wsafe.jpg")" alt="WSafe" class="navbar-brand-logo" />
                <span class="ml-1 font-weight-bold">WSafe</span>
            </a>

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="navbarNav" class="collapse navbar-collapse">
                <ul class="navbar-nav mr-auto">
                    @if (userRole == "ADMIN")
                    {
                        <li class="nav-item">@Html.ActionLink("ENTIDAD", "Index", "Organizations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("SG-SST", "Index", "Movimientos", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("EVALUACIONES", "Index", "Evaluations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("RIESGOS", "Index", "Riesgos", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("INCIDENTES", "Index", "Incidentes", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("ACCIONES", "Index", "Acciones", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("INDICADORES", "Index", "Indicadores", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("USUARIOS", "Index", "Accounts", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("TRABAJADORES", "Index", "Workers", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("ACTO_INSEGUROS", "Index", "Unsafeacts", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("RECOMENDACIONES", "Index", "Recomendations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("PLAN_ANUAL", "Index", "AnnualPlans", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("OCUPACIONALES", "Index", "Occupationals", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("CAPACITACIONES", "Index", "Capacitations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("VULNERABILIDADES", "Index", "Vulnerabilities", null, new { @class = "nav-link" })</li>
                    }
                    else if (userRole == "LIDER RESPONSABLE SST")
                    {
                        <li class="nav-item">@Html.ActionLink("RIESGOS", "Index", "Riesgos", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("INCIDENTES", "Index", "Incidentes", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("ACCIONES", "Index", "Acciones", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("ACTOS_INSEGUROS", "Index", "Unsafeacts", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("RECOMENDACIONES", "Index", "Recomendations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("PLAN_ANUAL", "Index", "AnnualPlans", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("CAPACITACIONES", "Index", "Capacitations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("VULNERABILIDADES", "Index", "Vulnerabilities", null, new { @class = "nav-link" })</li>
                    }
                    else if (userRole == "ARL")
                    {
                        <li class="nav-item">@Html.ActionLink("ENTIDAD", "Index", "Organizations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("SG-SST", "Index", "Movimientos", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("EVALUACIONES", "Index", "Evaluations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("PLAN_ANUAL", "Index", "AnnualPlans", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("VULNERABILIDADES", "Index", "Vulnerabilities", null, new { @class = "nav-link" })</li>
                    }
                    else if (userRole == "TRABAJADOR")
                    {
                        <li class="nav-item">@Html.ActionLink("TRABAJADORES", "GetWorker", "Workers", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("RIESGOS", "Create", "Riesgos", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("ACTOS_INSEGUROS", "Create", "Unsafeacts", null, new { @class = "nav-link" })</li>
                    }
                    else
                    {
                        <li class="nav-item">@Html.ActionLink("ACTOS_INSEGUROS", "Create", "Unsafeacts", null, new { @class = "nav-link" })</li>
                    }

                    <!-- Botones AI -->
                    <li class="nav-item"><a href="#" class="nav-link" data-toggle="modal" data-target="#mdlPredict">Predict</a></li>
                    <li class="nav-item"><a href="#" class="nav-link" data-toggle="modal" data-target="#mdlAudit">Audit</a></li>
                    <li class="nav-item"><a href="#" class="nav-link" data-toggle="modal" data-target="#mdlDetect">Detect</a></li>
                    <li class="nav-item"><a href="#" class="nav-link" id="btnHealthCheck"><i class="fa fa-stethoscope"></i> Health</a></li>
                </ul>

                <div class="ml-auto text-right">
                    @if (!string.IsNullOrEmpty(userName))
                    {
                        <span class="text-dark font-weight-bold mr-2">Hola: @userName</span>
                        <a href="#" class="text-dark" onclick="logout()"><i class="fa fa-sign-out-alt"></i> Cerrar sesión</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- ===== CONTENT ===== -->
    <div class="container-fluid body-content">
        @RenderBody()
        <hr />
        <footer class="d-flex align-items-center">
            <a class="btn btn-success btn-sm mr-3" href="@Url.Action("Index","Home")">
                <i class="fa fa-chevron-left"></i> Cerrar Módulo
            </a>
            <div class="flex-fill"></div>
            <small class="text-muted mb-0">&copy; @DateTime.Now.Year - WSafeApp</small>
        </footer>
    </div>

    <!-- ===== Chatbot Button & Window ===== -->
    <button id="openChatbot" class="btn btn-primary rounded-circle"
            style="position: fixed; bottom: 30px; right: 30px; z-index: 999;">
        💬
    </button>

    <div id="chatbotWindow"
         style="position: fixed; bottom: 90px; right: 30px; width: 400px; height: 500px;
                background-color: #f9f9f9; border: 1px solid #ccc; border-radius: 10px;
                padding: 15px; display: none; box-shadow: 0 0 10px rgba(0,0,0,0.2); z-index: 999;">
        <h5 class="mb-2">Soporte IA</h5>
        <div id="chatOutput" style="height: 320px; overflow-y: auto; background-color: #fff;
             padding: 10px; border: 1px solid #ddd; margin-bottom: 10px; font-size: 14px;"></div>
        <input type="text" id="chatInput" class="form-control mb-2" placeholder="Escribe tu pregunta..." />
        <div class="d-flex justify-content-between">
            <button class="btn btn-secondary" id="clearChat">🧹 Limpiar</button>
            <button class="btn btn-success" id="sendChat">Enviar</button>
        </div>
    </div>

    <!-- ===== Modals ===== -->
    <!-- Predict -->
    <div class="modal fade" id="mdlPredict" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Predict</h5>
                    <button class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group"><label>Activity</label><input id="predActivity" class="form-control" value="Trabajo en altura" /></div>
                    <div class="form-group"><label>Location</label><input id="predLocation" class="form-control" value="Planta Cali" /></div>
                    <div class="form-group"><label>HistoricalWindowMonths</label><input id="predWindow" type="number" class="form-control" value="12" /></div>
                    <div class="form-group"><label>TopNRecommendations (opcional)</label><input id="predTopN" type="number" class="form-control" value="3" /></div>
                    <pre id="outPredict" class="result d-none"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnPredict" class="btn btn-primary" data-loading-text="Procesando...">Enviar</button>
                    <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit -->
    <div class="modal fade" id="mdlAudit" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Audit</h5>
                    <button class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group"><label>Standard</label><input id="auditStd" class="form-control" value="ISO 45001" /></div>
                    <div class="form-group"><label>Content</label><textarea id="auditContent" rows="7" class="form-control">Política de SST 2025...</textarea></div>
                    <pre id="outAudit" class="result d-none"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnAudit" class="btn btn-primary" data-loading-text="Procesando...">Enviar</button>
                    <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Detect -->
    <div class="modal fade" id="mdlDetect" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detect</h5>
                    <button class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Reports (uno por línea)</label>
                        <textarea id="detectReports" rows="7" class="form-control">Operario sin arnés zona 3
Uso de celular en montacargas
Operario subiendo sin barandas</textarea>
                    </div>
                    <pre id="outDetect" class="result d-none"></pre>
                </div>
                <div class="modal-footer">
                    <button id="btnDetect" class="btn btn-primary" data-loading-text="Procesando...">Enviar</button>
                    <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <div id="toast" class="toast-wsafe"></div>

    <!-- ===== Scripts ===== -->
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")      <!-- Asegúrate que este bundle carga jQuery 3.x -->
    <!-- Popper y Bootstrap 4 (si tu bundle bootstrap ya los incluye, no repitas) -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    @Scripts.Render("~/bundles/jqueryunobtrusive")
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/bootstrap-table/bootstrap-table.min.js"></script>

    @Scripts.Render("~/Scripts/GestorRiesgos.js")
    @Scripts.Render("~/Scripts/AuditsGestor.js")
    @Scripts.Render("~/Scripts/CapacitationsGestor.js")
    @RenderSection("scripts", required: false)

    <script>
        // ---------- Utils ----------
        function toast(msg, ms){ var $t = $("#toast"); $t.text(msg).fadeIn(150); setTimeout(function(){ $t.fadeOut(250); }, ms||2600); }
        function pretty(o){ try{ return JSON.stringify(o, null, 2); } catch(e){ return o; } }
        function setBusy($btn, busy, txt){
            var normal = $btn.data("normal") || $btn.text();
            if(!$btn.data("normal")) $btn.data("normal", normal);
            $btn.prop("disabled", busy).text(busy ? (txt||"Procesando...") : normal);
        }
        function show($pre, data){ $pre.removeClass("d-none").text(pretty(data)); }

        // ---------- Chatbot ----------
        $("#openChatbot").on("click", function(){
            const $win = $("#chatbotWindow");
            $win.toggle();
        });
        $("#clearChat").on("click", function(){ $("#chatOutput").html(""); });
        $("#sendChat").on("click", async function(){
            const input = $("#chatInput");
            const output = $("#chatOutput");
            const prompt = (input.val()||"").trim();
            if(!prompt) return;

            output.append(`<div><strong>Tú:</strong> ${prompt}</div>`);
            input.val("");

            try{
                const res = await fetch("http://localhost:5005/api/Chatbot/support", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ prompt })
                });
                const data = await res.json();
                if(data.success){
                    const formatted = (data.response||"").includes('\n')
                        ? `<ul>${(data.response||"").split('\n').map(line=>`<li>${line}</li>`).join('')}</ul>`
                        : `<p>${data.response||""}</p>`;
                    output.append(`<div><strong>WSafe:</strong> ${formatted}</div>`);
                }else{
                    output.append(`<div class="text-danger"><strong>Error:</strong> ${data.errorMessage||"Error desconocido"}</div>`);
                }
                output.scrollTop(output[0].scrollHeight);
            }catch(err){
                output.append(`<div class="text-danger"><strong>Error:</strong> Falló la solicitud al servidor</div>`);
            }
        });

        // ---------- HealthCheck (GET /health en tu API .NET 8) ----------
        $("#btnHealthCheck").on("click", function(e){
            e.preventDefault();
            var baseUrl = "@(System.Configuration.ConfigurationManager.AppSettings["AnalysisApiBaseUrl"] ?? "http://localhost:5081")";
            $.get(baseUrl + "/health")
             .done(function(r){ toast("API OK: " + (r.status || "ok")); })
             .fail(function(){ toast("No se pudo conectar con la API"); });
        });

        // ---------- Predict ----------
        $("#btnPredict").on("click", function(){
            var $btn = $(this); setBusy($btn, true);
            $.ajax({
                url: "@Url.Action("Predict","Analysis")",
                method: "POST",
                data: {
                    activity: $("#predActivity").val(),
                    location: $("#predLocation").val(),
                    historicalWindowMonths: parseInt($("#predWindow").val()||"12"),
                    topNRecommendations: parseInt($("#predTopN").val()||"0") || null
                }
            })
            .done(function(r){ show($("#outPredict"), r); })
            .fail(function(e){ show($("#outPredict"), e.responseText || e.statusText); })
            .always(function(){ setBusy($btn,false); });
        });

        // ---------- Audit ----------
        $("#btnAudit").on("click", function(){
            var $btn = $(this); setBusy($btn, true);
            $.ajax({
                url: "@Url.Action("Audit","Analysis")",
                method: "POST",
                data: { standard: $("#auditStd").val(), content: $("#auditContent").val() }
            })
            .done(function(r){ show($("#outAudit"), r); })
            .fail(function(e){ show($("#outAudit"), e.responseText || e.statusText); })
            .always(function(){ setBusy($btn,false); });
        });

        // ---------- Detect ----------
        $("#btnDetect").on("click", function(){
            var $btn = $(this); setBusy($btn, true);
            var reports = ($("#detectReports").val()||"").split(/\r?\n/).filter(function(x){return x && x.trim().length>0;});
            $.ajax({
                url: "@Url.Action("Detect","Analysis")",
                method: "POST",
                traditional: true,
                data: { reports: reports }
            })
            .done(function(r){ show($("#outDetect"), r); })
            .fail(function(e){ show($("#outDetect"), e.responseText || e.statusText); })
            .always(function(){ setBusy($btn,false); });
        });
    </script>
</body>
</html>
